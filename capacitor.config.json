{
  "appId": "com.alfaylasouf.mubasis.focus",
  "appName": "الفيلسوف مبعسس",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#0B0D10"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_focus",
      "iconColor": "#2563EB",
      "sound": "strict_alarm.wav"
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0B0D10",
      "showSpinner": false
    }
  }
}
